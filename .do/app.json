{
  "name": "modelbanter",
  "region": "nyc",
  "envs": [
    { "key": "NODE_ENV", "scope": "RUN_AND_BUILD_TIME", "type": "GENERAL", "value": "production" },
    { "key": "DATABASE_URL", "scope": "RUN_TIME", "type": "SECRET", "value": "" },
    { "key": "CRON_SECRET", "scope": "RUN_TIME", "type": "SECRET", "value": "" },
    { "key": "X_BEARER_TOKEN", "scope": "RUN_TIME", "type": "SECRET", "value": "" },
    { "key": "TYPESAFE_JEV", "scope": "RUN_TIME", "type": "SECRET", "value": "" },
    { "key": "SENTIMENT_PROVIDER", "scope": "RUN_TIME", "type": "GENERAL", "value": "typesafe" },
    { "key": "TARGET_UNIQUE_POSTS_PER_MODEL", "scope": "RUN_TIME", "type": "GENERAL", "value": "100" },
    { "key": "X_MAX_PAGES_PER_MODEL", "scope": "RUN_TIME", "type": "GENERAL", "value": "20" },
    { "key": "X_RESULTS_PER_PAGE", "scope": "RUN_TIME", "type": "GENERAL", "value": "100" },
    { "key": "MODELS_PER_RUN", "scope": "RUN_TIME", "type": "GENERAL", "value": "3" },
    { "key": "NEXT_PUBLIC_SITE_URL", "scope": "RUN_AND_BUILD_TIME", "type": "GENERAL", "value": "https://modelbanter.com" },
    { "key": "NEXT_PUBLIC_POSTHOG_KEY", "scope": "RUN_AND_BUILD_TIME", "type": "GENERAL", "value": "" },
    { "key": "NEXT_PUBLIC_POSTHOG_HOST", "scope": "RUN_AND_BUILD_TIME", "type": "GENERAL", "value": "https://us.i.posthog.com" }
  ],
  "services": [
    {
      "name": "web",
      "github": { "repo": "hasnainsaad93/modelbanter", "branch": "main", "deploy_on_push": true },
      "environment_slug": "node-js",
      "source_dir": "/",
      "build_command": "npm run build",
      "run_command": "npm run start -- --hostname 0.0.0.0 --port 8080",
      "http_port": 8080,
      "instance_size_slug": "apps-s-1vcpu-1gb-fixed",
      "instance_count": 1,
      "health_check": { "http_path": "/api/health", "initial_delay_seconds": 20, "period_seconds": 15, "timeout_seconds": 10, "failure_threshold": 6 },
      "routes": [{ "path": "/" }]
    }
  ],
  "jobs": [
    {
      "name": "migrate",
      "kind": "PRE_DEPLOY",
      "github": { "repo": "hasnainsaad93/modelbanter", "branch": "main", "deploy_on_push": true },
      "environment_slug": "node-js",
      "source_dir": "/",
      "build_command": "npm run db:generate",
      "run_command": "npm run db:deploy",
      "instance_size_slug": "apps-s-1vcpu-0.5gb",
      "instance_count": 1
    },
    {
      "name": "collect",
      "kind": "SCHEDULED",
      "schedule": { "cron": "0 */4 * * *", "time_zone": "Etc/UTC" },
      "github": { "repo": "hasnainsaad93/modelbanter", "branch": "main", "deploy_on_push": true },
      "environment_slug": "node-js",
      "source_dir": "/",
      "build_command": "npm run db:generate",
      "run_command": "npm run ingest",
      "instance_size_slug": "apps-s-1vcpu-0.5gb",
      "instance_count": 1
    }
  ],
  "alerts": [{ "rule": "DEPLOYMENT_FAILED" }]
}
