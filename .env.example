DATABASE_URL="postgresql://postgres:postgres@localhost:5432/modelbanter?schema=public"
X_BEARER_TOKEN=""
CRON_SECRET=""
SENTIMENT_PROVIDER="typesafe"
TYPESAFE_JEV=""
TYPESAFE_MODEL="jev-1.13.0"
TARGET_UNIQUE_POSTS_PER_MODEL="100"
X_RESULTS_PER_PAGE="100"
X_MAX_PAGES_PER_MODEL="20"
MODELS_PER_RUN="3"
REANALYZE_LIMIT="100"
NEXT_PUBLIC_SITE_URL="https://modelbanter.com"
# Public project token (phc_...), never a PostHog personal API key.
NEXT_PUBLIC_POSTHOG_KEY=""
# Use the host shown in your project's setup: US or EU ingestion endpoint.
NEXT_PUBLIC_POSTHOG_HOST="https://us.i.posthog.com"

# Optional publication-date floor; older evidence is not collected again.
COLLECTION_START_AT="2026-10-01T00:00:00Z"

# Extra one-hop reply/quote lookups, shared across workers per UTC day.
# 20 reservations/day is at most ~$0.10/day at $0.005 per returned post.
# 0 disables remote context lookups; stored/cached context still works. Range 0–200.
X_CONTEXT_MAX_POSTS_PER_DAY=20

# Maximum mentions selected for a prepared reanalysis batch (1–100); previews by default.
REANALYZE_LIMIT=20
